# ====== Backend - Variáveis de Ambiente ======
# Copie este arquivo para .env e ajuste os valores

# Servidor
NODE_ENV=development
PORT=3001

# Banco de dados MySQL (Prisma)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL="mysql://root:root@localhost:3306/saassreb"

# JWT / Autenticação
JWT_SECRET=troque-esta-chave-por-uma-secreta-e-longa
JWT_EXPIRES_IN=8h

# CORS - origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate limiting (janela em minutos / máximo de requisições)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
